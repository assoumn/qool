# Server only. Never prefix credentials with VITE_ or commit a credential file.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Availability and quota depend on your project/region.
VEO_MODEL=veo-3.1-fast-generate-001
# Keep false until you have verified Veo access, pricing, and trial-credit coverage.
VEO_ENABLE_GENERATION=false
# Uses Application Default Credentials (ADC), e.g. gcloud auth application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
PORT=3001
APP_ORIGIN=http://localhost:5173
